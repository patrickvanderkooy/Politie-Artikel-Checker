        function filterArticles() {
            const rawQuery = document.getElementById('searchInput').value.toLowerCase().trim();
            if (!rawQuery) {
                renderArticles(database);
                return;
            }

            const justNumMatch = rawQuery.match(/\b\d+[a-z]?\b/i);
            const targetNum = justNumMatch ? justNumMatch[0].toLowerCase() : null;

            const normQuery = rawQuery.replace(/artikel/g, 'art').replace(/\./g, '').replace(/\s+/g, ' ');
            const queryTokens = normQuery.split(' ');

            let filtered = database.filter(item => {
                const normArticle = item.article.toLowerCase().replace(/artikel/g, 'art').replace(/\./g, '').replace(/\s+/g, ' ');
                const normLaw = item.law.toLowerCase().replace(/\./g, '');
                const normTitle = item.title.toLowerCase();
                const normText = item.text.toLowerCase();
                const normExpl = item.explanation.toLowerCase();
                const normEis = item.eis ? item.eis.toLowerCase() : '';
                const normConn = item.connection ? item.connection.toLowerCase() : '';

                const combinedText = `${normArticle} ${normLaw} ${normTitle} ${normText} ${normExpl} ${normEis} ${normConn}`;
                
                const matchesAll = queryTokens.every(token => combinedText.includes(token));
                const articleMatch = targetNum && normArticle.includes(targetNum);

                if (!(matchesAll || articleMatch)) return false;

                if (currentFilter === 'matrix') return item.inMatrix;
                if (currentFilter === 'vh') return item.vh;
                if (currentFilter === 'favs') return favorites.includes(item.id);

                return true;
            });

            filtered.sort((a, b) => {
                const matchA = a.article.toLowerCase().match(/\b\d+[a-z]?\b/i);
                const matchB = b.article.toLowerCase().match(/\b\d+[a-z]?\b/i);
                const numA = matchA ? matchA[0] : '';
                const numB = matchB ? matchB[0] : '';

                if (targetNum) {
                    const isExactA = numA === targetNum;
                    const isExactB = numB === targetNum;
                    if (isExactA && !isExactB) return -1;
                    if (!isExactA && isExactB) return 1;
                }

                const aMatch = a.article.toLowerCase().includes(rawQuery) ? 1 : 0;
                const bMatch = b.article.toLowerCase().includes(rawQuery) ? 1 : 0;
                return bMatch - aMatch;
            });

            renderArticles(filtered);
        }

