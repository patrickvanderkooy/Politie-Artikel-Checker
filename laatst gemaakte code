    <script>
        // Tabblad functionaliteit
        function openTab(evt, tabName) {
            const contents = document.getElementsByClassName("tab-content");
            for (let i = 0; i < contents.length; i++) {
                contents[i].classList.remove("active");
            }
            const buttons = document.getElementsByClassName("tab-btn");
            for (let i = 0; i < buttons.length; i++) {
                buttons[i].classList.remove("active");
            }
            document.getElementById(tabName).classList.add("active");
            evt.currentTarget.classList.add("active");
        }

        // Zoekfunctie artikelenbank
        function filterArticles() {
            const input = document.getElementById('searchBar').value.toLowerCase();
            const items = document.getElementsByClassName('wet-item');

            for (let i = 0; i < items.length; i++) {
                const keywords = items[i].getAttribute('data-keywords').toLowerCase();
                const text = items[i].innerText.toLowerCase();
                if (keywords.includes(input) || text.includes(input)) {
                    items[i].style.display = "";
                } else {
                    items[i].style.display = "none";
                }
            }
        }

        // Snelkoppeling knop
        function quickSearch(term) {
            document.getElementById('searchBar').value = term;
            filterArticles();
        }
    </script>
</body>
</html>
