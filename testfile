            {
                id: "sv27c", law: "Wetboek van Strafvordering", article: "Artikel 27c", title: "Rechten van de verdachte / Informatie", inMatrix: true, vh: false, exam: false,
                eis: "De student kan beschrijven welke rechten een verdachte heeft en hoe deze worden medegedeeld. (Wetboek van Strafvordering, artikel 27c) (K)",
