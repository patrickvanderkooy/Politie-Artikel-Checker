        function recordHistoryState() {
            const currentSearch = document.getElementById('searchInput') ? document.getElementById('searchInput').value : '';
            historyStack.push({
                tabId: currentTabId,
                searchQuery: currentSearch
            });
            if (historyStack.length > 20) historyStack.shift(); // Max 20 stappen
            document.getElementById('backBtn').disabled = historyStack.length <= 1;
        }

        function goBackHistory() {
            if (historyStack.length <= 1) return;
            // Verwijder huidige staat
            historyStack.pop();
            // Pak vorige staat
            const previousState = historyStack[historyStack.length - 1];
            
            if (previousState) {
                const targetBtn = document.getElementById(`btn-${previousState.tabId}`);
                switchTabInternal(previousState.tabId, targetBtn, false);
                if (previousState.tabId === 'articles-tab') {
                    const searchInput = document.getElementById('searchInput');
                    searchInput.value = previousState.searchQuery;
                    filterArticles();
                }
            }
            document.getElementById('backBtn').disabled = historyStack.length <= 1;
        }

        function switchTab(tabId, btn) {
            switchTabInternal(tabId, btn, true);
        }

        function switchTabInternal(tabId, btn, record = true) {
            currentTabId = tabId;
            document.querySelectorAll('.tab-content').forEach(t => t.classList.remove('active'));
            document.querySelectorAll('.nav-btn').forEach(b => b.classList.remove('active'));
            document.getElementById(tabId).classList.add('active');
            if (btn) btn.classList.add('active');

            if (record) {
                recordHistoryState();
            }

            if (tabId === 'quiz-tab') {
                generateQuestion();
            }
        }

