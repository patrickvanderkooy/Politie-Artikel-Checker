        let favorites = JSON.parse(localStorage.getItem('pol_favs') || '[]');
        let currentFilter = 'all';

        function switchTab(tabId, btn) {
            document.querySelectorAll('.tab-content').forEach(t => t.classList.remove('active'));
            document.querySelectorAll('.nav-btn').forEach(b => b.classList.remove('active'));
            document.getElementById(tabId).classList.add('active');
            btn.classList.add('active');

            if (tabId === 'quiz-tab') {
                generateQuestion();
            }
        }

        function toggleFav(id, btn) {
            if (favorites.includes(id)) {
                favorites = favorites.filter(f => f !== id);
                btn.classList.remove('active');
            } else {
                favorites.push(id);
                btn.classList.add('active');
            }
            localStorage.setItem('pol_favs', JSON.stringify(favorites));
            if (currentFilter === 'favs') filterArticles();
        }

        function renderArticles(items) {
            const container = document.getElementById('articlesContainer');
            const resultsInfo = document.getElementById('resultsInfo');
            
            container.innerHTML = '';
            resultsInfo.textContent = `${items.length} artikel(en) weergegeven`;

            if (items.length === 0) {
                container.innerHTML = `<div class="card" style="text-align:center; padding:2rem;">Geen resultaten gevonden. Probeer een ander zoekwoord (bijv. '310', '27a', 'Grondwet').</div>`;
                return;
            }

            items.forEach(item => {
                const isFav = favorites.includes(item.id);
                const card = document.createElement('div');
                card.className = 'card';

                let badgesHtml = item.inMatrix ? `<span class="badge badge-matrix">Toetsmatrijs</span>` : `<span class="badge badge-extra">Overig Wetboek</span>`;
                if (item.vh) badgesHtml += ` <span class="badge badge-vh">VH-feit (Paars)</span>`;
                if (item.exam) badgesHtml += ` <span class="badge badge-exam">Recente Toets (Groen)</span>`;

                const formattedConnection = formatConnections(item.connection);

                card.innerHTML = `
                    <div class="card-header">
                        <div>
                            <div style="font-size:0.75rem; font-weight:bold; color:var(--secondary); text-transform:uppercase;">${item.law}</div>
                            <h3 class="article-title">${item.article}: ${item.title}</h3>
                        </div>
                        <div style="display:flex; align-items:center;">
                            <div class="badges">${badgesHtml}</div>
                            <button class="fav-btn ${isFav ? 'active' : ''}" onclick="toggleFav('${item.id}', this)">★</button>
                        </div>
                    </div>
                    ${item.eis ? `<div class="eis-box"><strong>Eis Toetsmatrijs:</strong> ${item.eis}</div>` : ''}
                    <div class="article-text">${item.text}</div>
                    <div class="explanation">${item.explanation}</div>
                    ${item.connection ? `<div class="connection-box" style="background: #fffaf0; border: 1px solid #feebc8; border-left: 3px solid #dd6b20; padding: 0.75rem; border-radius: 4px; font-size: 0.88rem; color: #7b341e;"><strong>Wetsverband:</strong> ${formattedConnection}</div>` : ''}
                `;
                container.appendChild(card);
            });
        }

        function filterArticles() {
            const query = document.getElementById('searchInput').value.toLowerCase().trim();
            
            let filtered = database.filter(item => {
                const matchesQuery = 
                    item.article.toLowerCase().includes(query) ||
                    item.title.toLowerCase().includes(query) ||
                    item.text.toLowerCase().includes(query) ||
                    item.explanation.toLowerCase().includes(query) ||
                    item.law.toLowerCase().includes(query) ||
                    (item.eis && item.eis.toLowerCase().includes(query)) ||
                    (item.connection && item.connection.toLowerCase().includes(query));

                if (!matchesQuery) return false;

                if (currentFilter === 'matrix') return item.inMatrix;
                if (currentFilter === 'vh') return item.vh;
                if (currentFilter === 'extra') return !item.inMatrix;
                if (currentFilter === 'favs') return favorites.includes(item.id);

                return true;
            });

            if (query) {
                filtered.sort((a, b) => {
                    const aMatch = a.article.toLowerCase().includes(query) ? 1 : 0;
                    const bMatch = b.article.toLowerCase().includes(query) ? 1 : 0;
                    return bMatch - aMatch;
                });
            }

            renderArticles(filtered);
        }

        function setFilter(filter, btn) {
            currentFilter = filter;
            document.querySelectorAll('.filter-btn').forEach(b => b.classList.remove('active'));
            btn.classList.add('active');
            filterArticles();
        }

        let currentQuizQuestion = null;
        let score = 0;
        let questionCount = 0;

        function generateQuestion() {
            document.getElementById('quiz-feedback').style.display = 'none';
            document.getElementById('quiz-next-btn').style.display = 'none';

            let matrixItems = database.filter(d => d.inMatrix);
            const item = matrixItems[Math.floor(Math.random() * matrixItems.length)];

            const subVariant = Math.floor(Math.random() * 5);
            let questionText = "";
            let correctAnswer = "";
            let wrongPool = [];

            if (subVariant === 0) {
                questionText = `<strong>Examenstoets Vraag (VH-Feit):</strong> Is het delict <strong>${item.article} (${item.title})</strong> volgens de officiële toetsmatrijs aangemerkt als een <strong>Voorlopige Hechtenis feit (Paars)</strong>?`;
                correctAnswer = item.vh ? "Ja, dit is een VH-feit" : "Nee, dit is GEEN VH-feit";
                wrongPool = [
                    item.vh ? "Nee, dit is GEEN VH-feit" : "Ja, dit is een VH-feit",
                    "Uitsluitend indien er sprake is van heterdaad",
                    "Alleen bij medewerking van de verdachte"
                ];
            } else if (subVariant === 1) {
                questionText = `<strong>Wettekst Herkenning:</strong> Welk wetsartikel hoort exact bij deze bepaling of omschrijving?<br><em>"${item.text.substring(0, 95)}..."</em>`;
                correctAnswer = `${item.law} - ${item.article}: ${item.title}`;
                const others = matrixItems.filter(d => d.id !== item.id).sort(() => 0.5 - Math.random());
                wrongPool = others.slice(0, 3).map(o => `${o.law} - ${o.article}: ${o.title}`);
            } else if (subVariant === 2) {
                questionText = `<strong>Praktijkcasus Toetsmatrijs:</strong> ${item.eis || `Welke juridische norm is hier van toepassing bij ${item.title}?`}`;
                correctAnswer = `${item.law} - ${item.article}`;
                const others = matrixItems.filter(d => d.id !== item.id).sort(() => 0.5 - Math.random());
                wrongPool = others.slice(0, 3).map(o => `${o.law} - ${o.article}`);
            } else if (subVariant === 3) {
                questionText = `<strong>Wetgeving & Bevoegdheid:</strong> Wat is het primaire doel of criterium van <strong>${item.article} (${item.title})</strong> uit de wet ${item.law}?`;
                correctAnswer = item.title;
                const others = matrixItems.filter(d => d.id !== item.id).sort(() => 0.5 - Math.random());
                wrongPool = others.slice(0, 3).map(o => o.title);
            } else {
                questionText = `<strong>Toepassing in de Eenheid:</strong> Binnen welke wettelijke kaders valt de handhaving van <strong>${item.title}</strong> (${item.law} ${item.article})?`;
                correctAnswer = `Gekoppeld aan ${item.law} en relevante opsporingsbevoegdheden`;
                wrongPool = [
                    "Valt uitsluitend onder de autonome bevoegdheid van de burgemeester",
                    "Hiervoor is altijd een rechterlijk bevel vooraf vereist",
                    "Dit betreft uitsluitend een interne richtlijn zonder wettelijke basis"
                ];
            }

            const allOptions = [correctAnswer, ...wrongPool.slice(0, 3)].sort(() => Math.random() - 0.5);

            currentQuizQuestion = {
                question: questionText,
                correct: correctAnswer,
                options: allOptions,
                explanation: (item.eis ? `<strong>Toetsmatrijs Eis:</strong> ${item.eis}<br><br>` : '') + item.explanation + (item.connection ? `<br><br><strong>Wetsverband:</strong> ${item.connection}` : '')
            };

            questionCount++;
            document.getElementById('quiz-counter').textContent = `Examen Vraag #${questionCount} (Pool van 250+ vragen)`;
            document.getElementById('quiz-question').innerHTML = currentQuizQuestion.question;

            const optionsContainer = document.getElementById('quiz-options');
            optionsContainer.innerHTML = '';

            currentQuizQuestion.options.forEach(opt => {
                const btn = document.createElement('button');
                btn.className = 'quiz-option';
                btn.innerHTML = opt;
                btn.onclick = () => checkAnswer(opt, btn);
                optionsContainer.appendChild(btn);
            });
        }

        function checkAnswer(selectedOpt, btnElement) {
            const allBtns = document.querySelectorAll('.quiz-option');
            allBtns.forEach(b => b.onclick = null);

            const feedback = document.getElementById('quiz-feedback');
            feedback.style.display = 'block';

            if (selectedOpt === currentQuizQuestion.correct) {
                btnElement.classList.add('correct');
                feedback.style.background = '#c6f6d5';
                feedback.style.color = '#22543d';
                feedback.innerHTML = `<strong>Juist! 🎉 Goed geoefend voor de toets.</strong><br><br>${currentQuizQuestion.explanation}`;
                score++;
            } else {
                btnElement.classList.add('wrong');
                feedback.style.background = '#fed7d7';
                feedback.style.color = '#742a2a';
                feedback.innerHTML = `<strong>Onjuist.</strong> Het juiste examen-antwoord is: <strong>${currentQuizQuestion.correct}</strong>.<br><br>${currentQuizQuestion.explanation}`;
                
                allBtns.forEach(b => {
                    if (b.innerHTML === currentQuizQuestion.correct) {
                        b.classList.add('correct');
                    }
                });
            }

            document.getElementById('quiz-score').textContent = `Score: ${score} van de ${questionCount}`;
            document.getElementById('quiz-next-btn').style.display = 'inline-block';
        }

        renderArticles(database);
    </script>
</body>
</html>
